@model IEnumerable<Zoomarket.Models.Order>
@{
    ViewData["Title"] = "Управление заказами";
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}
<div class="admin-container">
    <a asp-action="Index" class="btn-back-admin">
        <i class="fa-solid fa-arrow-left"></i> Назад в админку
    </a>
    <h1>Управление заказами</h1>
    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Дата</th>
                <th>Клиент</th>
                <th>Сумма</th>
                <th>Статус</th>
                <th>Действие</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>#@order.Id</td>
                    <td>@order.OrderDate.ToString("dd.MM.yyyy")</td>
                    <td>
                        @{
                            var emails = ViewBag.UserEmails as Dictionary<string, string>;
                            string email = emails != null && emails.ContainsKey(order.UserId ?? "") ? emails[order.UserId] : "Неизвестный";
                        }
                        @email
                    </td>
                    <td>@order.TotalAmount.ToString("N0") ₽</td>
                    <td><span class="status-badge @order.Status.ToLower()">@order.Status</span></td>
                    <td>
                        <button class="btn-primary" style="padding: 5px 10px; font-size: 0.85rem;" onclick="openOrderModal(@order.Id, '@order.Status')">Изменить</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="custom-modal-overlay" id="orderModal" style="display: none;">
    <div class="custom-modal" style="max-width: 400px;">
        <h3>Смена статуса заказа</h3>
        <form asp-action="UpdateOrderStatus" method="post">
            <input type="hidden" name="orderId" id="modalOrderId" value="" />
            <div class="form-group">
                <label>Новый статус</label>
                <select name="status" id="modalOrderStatus" class="form-control">
                    <option value="В обработке">В обработке</option>
                    <option value="Собран">Собран</option>
                    <option value="Доставляется">Доставляется</option>
                    <option value="Доставлен">Доставлен</option>
                    <option value="Отменен">Отменен</option>
                </select>
            </div>
            <div style="display: flex; gap: 10px; margin-top: 20px;">
                <button type="button" onclick="closeModal('orderModal')" class="btn-outline" style="flex: 1;">Отмена</button>
                <button type="submit" class="btn-primary" style="flex: 1;">Сохранить</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openOrderModal(id, status) {
            document.getElementById('modalOrderId').value = id;
            document.getElementById('modalOrderStatus').value = status;
            document.getElementById('orderModal').style.display = 'flex';
        }
        function closeModal(modalId) { document.getElementById(modalId).style.display = 'none'; }
    </script>
}