@model IEnumerable<Zoomarket.Models.Review>
@{
    ViewData["Title"] = "Отзывы";
}

@section Styles {
    <link rel="stylesheet" href="~/css/reviews.css" asp-append-version="true" />
}

<!-- Креативный заголовок -->
<section class="reviews-hero">
    <div class="hero-image">
        <img src="~/img/free-icon-puffin-8142776.png" alt="Пингвинчик" />
    </div>
    <div class="hero-content">
        <h1>Отзывы наших клиентов</h1>
        <p>Мы гордимся доверием более 5000 владельцев питомцев</p>

        <!-- Декоративные лапки -->
        <div class="hero-decor paw-1"><i class="fa-solid fa-paw"></i></div>
        <div class="hero-decor paw-2"><i class="fa-solid fa-paw"></i></div>
        <div class="hero-decor paw-3"><i class="fa-solid fa-paw"></i></div>
    </div>
   
</section>

<div class="reviews-container">
    <div class="reviews-layout">

        <!-- Левая колонка: Форма добавления отзыва -->
        <div class="review-form-side">
            <div class="review-form-box">
                <h2>Оставить отзыв</h2>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group">
                            <label>Ваше имя</label>
                            <input name="AuthorName" class="form-control" placeholder="Иван Иванов" required />
                        </div>

                        <!-- ИНТЕРАКТИВНЫЕ ЗВЕЗДЫ -->
                        <div class="form-group">
                            <label>Ваша оценка</label>
                            <div class="star-rating">
                                <input type="radio" id="star5" name="Rating" value="5" checked />
                                <label for="star5" title="5 звезд"><i class="fa-solid fa-star"></i></label>

                                <input type="radio" id="star4" name="Rating" value="4" />
                                <label for="star4" title="4 звезды"><i class="fa-solid fa-star"></i></label>

                                <input type="radio" id="star3" name="Rating" value="3" />
                                <label for="star3" title="3 звезды"><i class="fa-solid fa-star"></i></label>

                                <input type="radio" id="star2" name="Rating" value="2" />
                                <label for="star2" title="2 звезды"><i class="fa-solid fa-star"></i></label>

                                <input type="radio" id="star1" name="Rating" value="1" />
                                <label for="star1" title="1 звезда"><i class="fa-solid fa-star"></i></label>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Текст отзыва</label>
                            <textarea name="Text" class="form-control" rows="5" placeholder="Поделитесь впечатлениями..." required></textarea>
                        </div>

                        <button type="submit" class="btn-primary w-100">Отправить</button>
                    </form>
                }
                else
                {
                    <p style="color: var(--text-muted); margin-bottom: 20px;">Чтобы оставить отзыв, пожалуйста, войдите в аккаунт.</p>
                    <a asp-controller="Account" asp-action="Login" class="btn-primary w-100" style="display: block; text-align: center;">Войти</a>
                }
            </div>
        </div>

        <!-- Правая колонка: Список отзывов -->
        <div class="reviews-list-side">
            <h2>Что говорят о нас</h2>

            @if (!Model.Any())
            {
                <p style="color: var(--text-muted); font-size: 1.1rem;">Пока нет отзывов. Будьте первым!</p>
            }
            else
            {
                @foreach (var review in Model)
                {
                    <div class="review-card">
                        <div class="review-header">
                            <div class="review-avatar">@review.AuthorName.Substring(0, 1).ToUpper()</div>
                            <div class="review-author-info">
                                <h4>@review.AuthorName</h4>
                                <span class="review-date">@review.DateCreated.ToString("dd.MM.yyyy")</span>
                            </div>
                        </div>

                        <div class="review-stars">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= review.Rating)
                                {
                                    <i class="fa-solid fa-star"></i>
                                }
                                else
                                {
                                    <i class="fa-regular fa-star"></i>
                                }
                            }
                        </div>

                        <p class="review-text">"@review.Text"</p>
                    </div>
                }
            }
        </div>
    </div>
</div>
@if (TempData["ReviewMessage"] != null)
{
    <div class="custom-modal-overlay" id="reviewModal">
        <div class="custom-modal @TempData["ReviewStatus"]">
            <div class="modal-icon">
                @if (TempData["ReviewStatus"]?.ToString() == "success")
                {
                    <i class="fa-solid fa-circle-check"></i>
                }
                else
                {
                    <i class="fa-solid fa-circle-exclamation"></i>
                }
            </div>
            <h3>@(TempData["ReviewStatus"]?.ToString() == "success" ? "Успешно!" : "Ошибка")</h3>
            <p>@TempData["ReviewMessage"]</p>
            <button onclick="closeModal()" class="btn-primary">Понятно</button>
        </div>
    </div>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function closeModal() {
            var modal = document.getElementById('reviewModal');
            if (modal) {
                modal.style.display = 'none';
            }
        }

        // Автоматическое закрытие через 5 секунд (опционально)
        window.onload = function () {
            var modal = document.getElementById('reviewModal');
            if (modal) {
                setTimeout(function () {
                    modal.style.display = 'none';
                }, 5000);
            }
        };
    </script>
}