@{
    ViewData["Title"] = "Контакты";
}

<section class="contact-hero">
    <div class="hero-content">
        <h1>Свяжитесь с нами</h1>
        <p>Мы всегда рады помочь вам и вашим питомцам</p>

        <div class="hero-decor paw-1"><i class="fa-solid fa-paw"></i></div>
        <div class="hero-decor paw-2"><i class="fa-solid fa-paw"></i></div>
        <div class="hero-decor paw-3"><i class="fa-solid fa-paw"></i></div>
    </div>

    <div class="hero-image">
        <img src="~/img/free-icon-animal-1370883.png" alt="Кот и собака" />
    </div>
</section>

<section class="contacts-wrapper">
    <div class="contact-info">
        <h2>Наши контакты</h2>

        <div class="info-item">
            <span class="info-icon"><i class="fa-solid fa-location-dot"></i></span>
            <div>
                <h4>Адрес</h4>
                <p>г. Москва, ул. Зоологическая, д. 15</p>
            </div>
        </div>

        <div class="info-item">
            <span class="info-icon"><i class="fa-solid fa-phone"></i></span>
            <div>
                <h4>Телефон</h4>
                <p>+7 (999) 123-45-67</p>
            </div>
        </div>

        <div class="info-item">
            <span class="info-icon"><i class="fa-solid fa-envelope"></i></span>
            <div>
                <h4>Email</h4>
                <p>info@zoomarket.ru</p>
            </div>
        </div>

        <div class="info-item">
            <span class="info-icon"><i class="fa-regular fa-clock"></i></span>
            <div>
                <h4>Режим работы</h4>
                <p>Пн-Вс: с 09:00 до 21:00</p>
            </div>
        </div>
    </div>

    <div class="contact-form-wrapper">
        <h2>Напишите нам</h2>
        <form asp-controller="Lead" asp-action="Create" method="post" class="contact-form">
            <div class="form-group">
                <label>Ваше имя</label>
                <input type="text" name="Name" placeholder="Иван Иванов" required>
            </div>
            <div class="form-group">
                <label>Email</label>
                <input type="email" name="Email" placeholder="ivan@mail.ru" required>
            </div>
            <div class="form-group">
                <label>Сообщение</label>
                <textarea name="Message" rows="5" placeholder="Чем мы можем вам помочь?" required></textarea>
            </div>
            <button type="submit" class="btn-primary">Отправить сообщение</button>
        </form>
    </div>
</section>

<section class="map-section">
    <div class="map-container">
        <h2>Мы на карте</h2>
        <div class="map-wrapper">
           
            <iframe src="https://yandex.ru/map-widget/v1/?um=constructor%3A22a50d67b0d7b9fbde6466aeb19752bc4ba639b7c4c0901caca403f3d41a1d6a&amp"
                    width="100%"
                    height="400"
                    frameborder="0"
                    allowfullscreen="true">
            </iframe>
           
        </div>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/contacts.css" asp-append-version="true" />
}