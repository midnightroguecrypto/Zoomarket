@model IEnumerable<Zoomarket.Models.Review>
@{
    ViewData["Title"] = "Мои отзывы";
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<section class="profile-hero">
    <div class="hero-content">
        <h1>Личный кабинет</h1>
        <p>Добро пожаловать, @ViewBag.FullName!</p>
        <div class="hero-decor paw-1"><i class="fa-solid fa-paw"></i></div>
        <div class="hero-decor paw-2"><i class="fa-solid fa-paw"></i></div>
        <div class="hero-decor paw-3"><i class="fa-solid fa-paw"></i></div>
    </div>
    <div class="hero-image">
        <img src="~/img/free-icon-pet-house-3047928.png" alt="Дом" />
    </div>
</section>

@if (TempData["ProfileMessage"] != null)
{
    <div class="profile-alert @TempData["ProfileStatus"]" style="max-width: 1200px; margin: 20px auto; padding: 15px 20px; border-radius: 12px; text-align: center;">
        @TempData["ProfileMessage"]
    </div>
}

<div class="profile-container">
    <partial name="_ProfileSidebar" />

    <div class="profile-content">
        <h2>Мои отзывы</h2>

        @if (!Model.Any())
        {
            <p style="color: var(--text-muted); margin-top: 20px;">
                Вы еще не оставили ни одного отзыва. <a asp-controller="Reviews" asp-action="Index" style="color: var(--primary-color); font-weight: 600;">Оставить отзыв</a>
            </p>
        }
        else
        {
            @foreach (var review in Model)
            {
                <div class="user-review-card">
                    <div class="review-header">
                        <div class="review-stars">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= review.Rating)
                                {
                                    <i class="fa-solid fa-star"></i>
                                }
                                else
                                {
                                    <i class="fa-regular fa-star"></i>
                                }
                            }
                        </div>
                        <span class="review-date">@review.DateCreated.ToString("dd.MM.yyyy")</span>
                    </div>
                    <p class="review-text">"@review.Text"</p>

                    <form asp-action="DeleteReview" method="post" onsubmit="return confirm('Вы уверены, что хотите удалить этот отзыв?');" style="margin-top: 15px;">
                        <input type="hidden" name="reviewId" value="@review.Id" />
                        <button type="submit" class="btn-delete-review">
                            <i class="fa-solid fa-trash"></i> Удалить отзыв
                        </button>
                    </form>
                </div>
            }
        }
    </div>
</div>
</div>