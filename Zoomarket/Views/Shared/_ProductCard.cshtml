@model Zoomarket.Models.Product
@{
    // Проверяем, есть ли у товара акция и скидка
    var activePromo = Model.Promotions?.FirstOrDefault();
    var hasDiscount = Model.OldPrice.HasValue && Model.OldPrice > Model.Price;
}

<div class="product-card">
    <!-- Плашки остаются сверху и не являются ссылками -->
    @if (activePromo != null && hasDiscount)
    {
        <span class="promo-card-badge" title="@activePromo.Title">
            <i class="fa-solid fa-tag"></i> @(activePromo.DiscountText ?? "Акция")
        </span>
    }

    @if (Model.DateCreated >= DateTime.UtcNow.AddDays(-14))
    {
        <span class="new-card-badge">Новинка</span>
    }

    <!-- Ссылка на весь блок с картинкой (правильный способ) -->
    <a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.Id" class="product-link-wrapper">
        <div class="product-image-wrapper">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name">
            }
            else
            {
                <div style="height: 220px; background: #e0dcd3; display:flex; align-items:center; justify-content:center;">Нет фото</div>
            }
        </div>
    </a>

    <div class="product-info">
        <span class="product-category">@Model.Category?.Name</span>

        <!-- Ссылка на заголовок -->
        <h3>
            <a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.Id" class="product-title-link">
                @Model.Name
            </a>
        </h3>

        <p class="product-short-desc">@Model.ShortDescription</p>

        <div class="product-bottom">
            <div class="product-prices">
                @if (Model.OldPrice.HasValue)
                {
                    <span class="old-price">@Model.OldPrice.Value.ToString("N0") ₽</span>
                }
                <span class="new-price">@Model.Price.ToString("N0") ₽</span>
            </div>
            <form asp-controller="Cart" asp-action="Add" method="post" style="display:inline;">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn-cart"><i class="fa-solid fa-cart-plus"></i></button>
            </form>

        </div>
    </div>
</div>